# --- Bắt buộc ---
# Chuỗi kết nối PostgreSQL. Trên server thật, đặt mật khẩu mạnh.
DATABASE_URL=postgres://xoaychieu:doi_mat_khau_that@localhost:5432/xoaychieu

# Bí mật ký cookie phiên. Tạo bằng:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu

# --- Tuỳ chọn ---
NODE_ENV=development
PORT=3000
SESSION_HOURS=12
TRUST_PROXY=false
# Nhiều nguồn thì ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# --- Chỉ dùng khi tạo tài khoản quản trị đầu tiên ---
# Không đặt các biến này trong file .env production đang chạy.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=
