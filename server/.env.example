# =====================================================================
#  Xoay Chiều — biến môi trường
#  Sao chép tệp này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# =====================================================================

# --- Bắt buộc ---------------------------------------------------------

# Chuỗi kết nối PostgreSQL. Trên production phải dùng mật khẩu mạnh và
# tài khoản chỉ có quyền trên database của dự án (xem db/roles.sql).
DATABASE_URL=postgres://xoaychieu:doi_mat_khau_that@127.0.0.1:5432/xoaychieu

# Bí mật ký cookie phiên, tối thiểu 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi giá trị này sẽ đăng xuất toàn bộ người dùng đang đăng nhập.
COOKIE_SECRET=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu

# --- Tuỳ chọn ---------------------------------------------------------

# development | test | production
# production bật cờ Secure cho cookie, bật HSTS và ẩn chi tiết lỗi 500.
NODE_ENV=development

PORT=3000

# Số giờ một phiên đăng nhập tồn tại trước khi phải đăng nhập lại.
SESSION_HOURS=12

# Đặt true khi chạy sau Nginx/Cloudflare để giới hạn tần suất tính đúng IP.
TRUST_PROXY=false

# Danh sách nguồn được gọi API, cách nhau bằng dấu phẩy.
# KHÔNG dùng * vì cookie phiên được gửi kèm.
CORS_ORIGIN=http://localhost:5173

# --- Chỉ dùng một lần khi tạo quản trị viên đầu tiên ------------------
# Không đặt các biến này trong .env của production đang chạy.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=
